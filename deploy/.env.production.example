# Copy to .env beside docker-compose.prod.yml and fill every value.
# No real secret belongs in git.

APP_ENV=production
POSTGRES_DB=laundromat
POSTGRES_USER=laundromat
POSTGRES_PASSWORD=

# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Leave REDIS_URL empty to use the in-process realtime fan-out.
REDIS_URL=

STORE_ID=laundromat-main
STORE_TIMEZONE=Africa/Lagos

# Public URLs used by the browser build, Paystack callbacks, and Google OAuth.
FRONTEND_URL=https://laundromat.accredit.vip
PUBLIC_API_URL=https://api.laundromat.accredit.vip/api/v1
NEXT_PUBLIC_API_URL=https://api.laundromat.accredit.vip/api/v1
NEXT_PUBLIC_WS_URL=wss://api.laundromat.accredit.vip/ws
CORS_ORIGINS=https://laundromat.accredit.vip
PAYSTACK_CALLBACK_URL=https://laundromat.accredit.vip/checkout/callback

# Country selector default for phone fields (ISO 3166-1 alpha-2).
# Inlined into the web build, so rebuild the web image after changing it.
NEXT_PUBLIC_DEFAULT_COUNTRY=NG

# Google sign in. Create an OAuth 2.0 Client (Web application) in Google Cloud
# and add this exact Authorized redirect URI:
#   https://api.laundromat.accredit.vip/api/v1/auth/google/callback
# Leave both values blank to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to PUBLIC_API_URL + /auth/google/callback.
GOOGLE_REDIRECT_URI=

# Phone code sign in. Set true only after an SMS provider is connected.
SMS_ENABLED=false

# Card payments stay hidden until a real key is set. Use sk_test_... for
# staging and sk_live_... for production. Any other value disables cards.
PAYSTACK_SECRET_KEY=

WASH_MINUTES=35
DRY_MINUTES=20
GRACE_MINUTES=10
MAX_WAIT_MINUTES=120
WASH_PRICE_KOBO=400000
QUEUE_OPEN=08:00
QUEUE_CLOSE=19:30
ORDER_NO_START=1025

# Production never seeds demo accounts.
SEED_DEMO=false
